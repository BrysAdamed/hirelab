{
  "openapi": "3.1.1",
  "info": {
    "title": "HireLab.Api | staff",
    "version": "1.0.0"
  },
  "paths": {
    "/api/staff/auth/antiforgery": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Issues the XSRF-TOKEN cookie for the current user, signed in or not.",
        "operationId": "GetAntiforgeryToken",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logs in with email and password, sets the staff cookie and a new XSRF-TOKEN, and returns the user.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Ends the staff session and issues an XSRF-TOKEN for the anonymous user.",
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Returns the signed-in staff user: id, email, display name, role and team.",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentUserResponse": {
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "team"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentUserTeamResponse"
              }
            ]
          }
        }
      },
      "CurrentUserTeamResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StaffRole": {
        "enum": [
          "Admin",
          "Manager",
          "Interviewer"
        ],
        "description": "The fixed role of a staff user (ADR 0009, ADR 0020). Sent over the wire by name."
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    }
  ]
}