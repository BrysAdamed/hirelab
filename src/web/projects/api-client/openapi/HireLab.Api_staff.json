{
  "openapi": "3.1.1",
  "info": {
    "title": "HireLab.Api | staff",
    "version": "1.0.0"
  },
  "paths": {
    "/api/staff/auth/antiforgery": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Issues the XSRF-TOKEN cookie for the current user, signed in or not.",
        "operationId": "GetAntiforgeryToken",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logs in with email and password, sets the staff cookie and a new XSRF-TOKEN, and returns the user.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Ends the staff session and issues an XSRF-TOKEN for the anonymous user.",
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Returns the signed-in staff user: id, email, display name, role and team.",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Changes the signed-in user's password. Their other sessions end; this one continues.",
        "operationId": "ChangePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/managers": {
      "get": {
        "tags": [
          "Invites"
        ],
        "summary": "Lists manager invites, newest first, until 30 days after they expire.",
        "operationId": "ListManagerInvites",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InviteResponse"
                  }
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Invites a manager into a new team (newTeamName) or an existing team without an active manager (teamId). Revokes any open invite for the same email and returns the link, which is shown only once.",
        "operationId": "CreateManagerInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateManagerInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedInviteResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/managers/{inviteId}/revoke": {
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Revokes an invite that hasn't been used, so its link stops working.",
        "operationId": "RevokeManagerInvite",
        "parameters": [
          {
            "name": "inviteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/managers/teams-without-manager": {
      "get": {
        "tags": [
          "Invites"
        ],
        "summary": "Lists the teams without an active manager, which a manager invite can hand over.",
        "operationId": "ListTeamsWithoutManager",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeamWithoutManagerResponse"
                  }
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/interviewers": {
      "get": {
        "tags": [
          "Invites"
        ],
        "summary": "Lists the interviewer invites of the manager's team, newest first, until 30 days after they expire.",
        "operationId": "ListInterviewerInvites",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InviteResponse"
                  }
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Invites an interviewer into the manager's team. Revokes any open invite for the same email and returns the link, which is shown only once.",
        "operationId": "CreateInterviewerInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInterviewerInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedInviteResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/interviewers/{inviteId}/revoke": {
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Revokes an invite that hasn't been used, so its link stops working.",
        "operationId": "RevokeInterviewerInvite",
        "parameters": [
          {
            "name": "inviteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/preview": {
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Returns the invitee, role and team of a pending invite link.",
        "operationId": "PreviewInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitePreviewResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/redeem": {
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Redeems an invite link with the invitee's new password: creates the user (and the team of a new-team invite), logs them in with a new XSRF-TOKEN and returns the user.",
        "operationId": "RedeemInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/reset-links/managers/{userId}": {
      "post": {
        "tags": [
          "ResetLinks"
        ],
        "summary": "Generates a reset link for the user. Revokes the user's previous unused link and returns the new one, which is shown only once.",
        "operationId": "GenerateManagerResetLink",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedResetLinkResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/reset-links/interviewers/{userId}": {
      "post": {
        "tags": [
          "ResetLinks"
        ],
        "summary": "Generates a reset link for the user. Revokes the user's previous unused link and returns the new one, which is shown only once.",
        "operationId": "GenerateInterviewerResetLink",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedResetLinkResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/reset-links/preview": {
      "post": {
        "tags": [
          "ResetLinks"
        ],
        "summary": "Returns whose password a pending reset link sets.",
        "operationId": "PreviewResetLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewResetLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetLinkPreviewResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/reset-links/redeem": {
      "post": {
        "tags": [
          "ResetLinks"
        ],
        "summary": "Redeems a reset link with the user's new password: clears the lockout and ends the user's existing sessions. The user then logs in with the new password.",
        "operationId": "RedeemResetLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CreateInterviewerInviteRequest": {
        "required": [
          "email",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "CreateManagerInviteRequest": {
        "required": [
          "email",
          "displayName",
          "teamId",
          "newTeamName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "teamId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "newTeamName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CurrentUserResponse": {
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "team"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentUserTeamResponse"
              }
            ]
          }
        }
      },
      "CurrentUserTeamResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "InvitePreviewResponse": {
        "required": [
          "email",
          "displayName",
          "role",
          "teamName",
          "isNewTeam",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          },
          "teamName": {
            "type": [
              "null",
              "string"
            ]
          },
          "isNewTeam": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InviteResponse": {
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "team",
          "expiresAt",
          "state"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InviteTeamResponse"
              }
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "$ref": "#/components/schemas/OneTimeLinkState"
          }
        }
      },
      "InviteTeamResponse": {
        "required": [
          "id",
          "name",
          "isNew"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "isNew": {
            "type": "boolean"
          }
        }
      },
      "IssuedInviteResponse": {
        "required": [
          "invite",
          "linkPath"
        ],
        "type": "object",
        "properties": {
          "invite": {
            "$ref": "#/components/schemas/InviteResponse"
          },
          "linkPath": {
            "type": "string"
          }
        }
      },
      "IssuedResetLinkResponse": {
        "required": [
          "userId",
          "expiresAt",
          "linkPath"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "linkPath": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OneTimeLinkState": {
        "enum": [
          "Pending",
          "Used",
          "Revoked",
          "Expired"
        ]
      },
      "PreviewInviteRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "PreviewResetLinkRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RedeemInviteRequest": {
        "required": [
          "token",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ResetLinkPreviewResponse": {
        "required": [
          "email",
          "displayName",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResetPasswordRequest": {
        "required": [
          "token",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "StaffRole": {
        "enum": [
          "Admin",
          "Manager",
          "Interviewer"
        ],
        "description": "The fixed role of a staff user (ADR 0009, ADR 0020). Sent over the wire by name."
      },
      "TeamWithoutManagerResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Invites"
    },
    {
      "name": "ResetLinks"
    }
  ]
}