              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Invites a manager into a new team (newTeamName) or an existing team without an active manager (teamId). Revokes any open invite for the same email and returns the link, which is shown only once.",
        "operationId": "CreateManagerInvite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateManagerInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedInviteResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/invites/managers/{inviteId}/revoke": {
      "post": {
        "tags": [
          "Invites"
        ],
        "summary": "Revokes an invite that hasn't been used, so its link stops working.",
