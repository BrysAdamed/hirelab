    "/api/staff/teams/{teamId}/rename": {
      "post": {
        "tags": [
          "Teams"
        ],
        "summary": "Renames a team. Its id, members and data stay the same.",
        "operationId": "RenameTeam",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameTeamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Lists every user, active and deactivated, by display name.",
        "operationId": "ListUsers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserResponse"
                  }
                }
              }
            }
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/users/{userId}/deactivate": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Deactivates a user: they can't log in, their sessions end within 5 minutes and the pending invites they issued are revoked. Nobody can deactivate themselves.",
        "operationId": "DeactivateUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/users/{userId}/reactivate": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Reactivates a deactivated user. A manager is refused while their team has another active manager.",
        "operationId": "ReactivateUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/users/{userId}/reassign": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Moves an interviewer to another team. Their sessions end within 5 minutes, so they lose the old team's data. Invites are not affected.",
        "operationId": "ReassignUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReassignUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed. The body describes the problem.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/my-team/interviewers": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Lists the interviewers of the manager's team, active and deactivated, by display name.",
