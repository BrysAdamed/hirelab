  },
  "components": {
    "schemas": {
      "CreateInterviewerInviteRequest": {
        "required": [
          "email",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "CreateManagerInviteRequest": {
        "required": [
          "email",
          "displayName",
          "teamId",
          "newTeamName"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "teamId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "newTeamName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CurrentUserResponse": {
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "team"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentUserTeamResponse"
              }
            ]
          }
        }
      },
      "CurrentUserTeamResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "InvitePreviewResponse": {
        "required": [
          "email",
          "displayName",
          "role",
          "teamName",
          "isNewTeam",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          },
          "teamName": {
            "type": [
              "null",
              "string"
            ]
          },
          "isNewTeam": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InviteResponse": {
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "team",
          "expiresAt",
          "state"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InviteTeamResponse"
              }
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "$ref": "#/components/schemas/OneTimeLinkState"
          }
        }
      },
      "InviteTeamResponse": {
        "required": [
          "id",
          "name",
          "isNew"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "isNew": {
            "type": "boolean"
          }
        }
      },
      "IssuedInviteResponse": {
        "required": [
          "invite",
          "linkPath"
        ],
        "type": "object",
        "properties": {
          "invite": {
            "$ref": "#/components/schemas/InviteResponse"
          },
          "linkPath": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OneTimeLinkState": {
        "enum": [
          "Pending",
          "Used",
          "Revoked",
          "Expired"
        ]
      },
      "PreviewInviteRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
